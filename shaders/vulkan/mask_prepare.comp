#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_input_mask;
layout(binding = 1, rgba8) writeonly uniform image2D u_output_mask;
layout(std430, binding = 2) readonly buffer CorrectionStorage {
    vec4 entries[];
} u_corrections;

layout(push_constant) uniform Push {
    ivec2 outputSize;
    ivec2 inputSize;
    int invert;
    int applyCorrections;
} pc;

float maskValueAt(ivec2 srcCoord)
{
    return texelFetch(u_input_mask, clamp(srcCoord, ivec2(0), max(pc.inputSize - ivec2(1), ivec2(0))), 0).r;
}

float bilinearMaskValue(vec2 srcPosition)
{
    // Work in texel-center coordinates.  This preserves continuous alpha when
    // mask artifacts and render targets have different resolutions instead of
    // turning diagonal and curved boundaries into nearest-neighbour steps.
    vec2 basePosition = floor(srcPosition);
    vec2 fraction = srcPosition - basePosition;
    ivec2 base = ivec2(basePosition);
    float top = mix(maskValueAt(base), maskValueAt(base + ivec2(1, 0)), fraction.x);
    float bottom = mix(maskValueAt(base + ivec2(0, 1)),
                       maskValueAt(base + ivec2(1, 1)),
                       fraction.x);
    return mix(top, bottom, fraction.y);
}

bool correctionPolygonContains(uint polygonIndex, vec2 point)
{
    uint polygonCount = uint(max(u_corrections.entries[0].x, 0.0) + 0.5);
    vec4 header = u_corrections.entries[1 + polygonIndex];
    uint firstPoint = uint(max(header.x, 0.0) + 0.5);
    uint pointCount = uint(max(header.y, 0.0) + 0.5);
    if (pointCount < 3) {
        return false;
    }
    uint pointBase = 1 + polygonCount + firstPoint;
    bool inside = false;
    uint previous = pointCount - 1;
    for (uint current = 0; current < pointCount; ++current) {
        vec2 a = u_corrections.entries[pointBase + current].xy;
        vec2 b = u_corrections.entries[pointBase + previous].xy;
        bool crosses = ((a.y > point.y) != (b.y > point.y)) &&
            (point.x < (b.x - a.x) * (point.y - a.y) /
                               (b.y - a.y) +
                           a.x);
        if (crosses) {
            inside = !inside;
        }
        previous = current;
    }
    return inside;
}

float correctionCoverage(ivec2 dstCoord)
{
    uint polygonCount = uint(max(u_corrections.entries[0].x, 0.0) + 0.5);
    if (polygonCount == 0) {
        return 0.0;
    }
    const vec2 sampleOffsets[4] = vec2[](
        vec2(0.25, 0.25),
        vec2(0.75, 0.25),
        vec2(0.25, 0.75),
        vec2(0.75, 0.75));
    float covered = 0.0;
    for (int sampleIndex = 0; sampleIndex < 4; ++sampleIndex) {
        vec2 point =
            (vec2(dstCoord) + sampleOffsets[sampleIndex]) /
            vec2(max(pc.outputSize, ivec2(1)));
        bool erased = false;
        for (uint polygonIndex = 0;
             polygonIndex < polygonCount && !erased;
             ++polygonIndex) {
            erased = correctionPolygonContains(polygonIndex, point);
        }
        covered += erased ? 0.25 : 0.0;
    }
    return covered;
}

void main()
{
    ivec2 dstCoord = ivec2(gl_GlobalInvocationID.xy);
    if (dstCoord.x >= pc.outputSize.x || dstCoord.y >= pc.outputSize.y) {
        return;
    }

    vec2 dstUv = (vec2(dstCoord) + vec2(0.5)) / vec2(max(pc.outputSize, ivec2(1)));
    vec2 srcPosition = dstUv * vec2(max(pc.inputSize, ivec2(1))) - vec2(0.5);
    float value = bilinearMaskValue(srcPosition);
    if (pc.applyCorrections != 0) {
        value *= 1.0 - correctionCoverage(dstCoord);
    }
    if (pc.invert != 0) {
        value = 1.0 - value;
    }
    imageStore(u_output_mask, dstCoord, vec4(value, value, value, 1.0));
}
